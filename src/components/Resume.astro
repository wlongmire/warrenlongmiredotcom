---
// Track-specific resumes. Edit the list in src/data/resumes.ts; PDFs live in public/resumes/.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { resumes } from '../data/resumes';

const items = resumes.map((r) => ({
  ...r,
  available: existsSync(join(process.cwd(), 'public', 'resumes', r.file)),
}));
---
<section id="resume" class="resume" aria-labelledby="resume-title">
  <div class="wrap rs-inner">
    <h2 id="resume-title">Resumes</h2>
    <p class="rs-lead">Pick the version closest to the role you're hiring for.</p>
    <ul class="rs-grid">
      {items.map((r) => (
        <li class="rs-card">
          <h3>{r.title}</h3>
          <p>{r.audience}</p>
          {r.available ? (
            <a class="rs-btn" href={`/resumes/${r.file}`} download>Download PDF</a>
          ) : (
            <span class="rs-soon">Coming soon</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .resume { position: relative; z-index: 2; border-top: 1px solid var(--rule); padding: 72px 0 96px; } /* padding on the section: .wrap resets its own */
  .resume h2 { font: 600 clamp(28px, 4vw, 40px)/1.15 'Fraunces', Georgia, serif; margin: 0 0 20px; padding-bottom: 20px; border-bottom: 1px solid var(--rule); }
  .rs-lead { color: var(--muted); margin: 0 0 32px; }
  .rs-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .rs-card { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 24px; }
  .rs-card h3 { font: 600 24px/1.2 'Fraunces', Georgia, serif; margin: 0 0 8px; }
  .rs-card p { margin: 0 0 20px; color: var(--muted); }
  .rs-btn, .rs-soon { margin-top: auto; align-self: flex-start; font-weight: 600; font-size: 15px; border-radius: 4px; padding: 10px 18px; }
  .rs-btn { background: var(--amber); color: var(--on-amber); text-decoration: none; }
  .rs-btn:hover { filter: brightness(1.08); }
  .rs-soon { border: 1.5px dashed var(--rule); color: var(--muted); }
</style>
