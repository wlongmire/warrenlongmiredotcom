          if (r.status === 401) { location.reload(); return; }
          if (!r.ok) { setStatus(msg, r.data.error || 'Upload failed.', 'error'); return; }
          var doc = $('#doc'), fit = 'contain', alt = about ? '' : altFromName(r.data.reference);
          mediaSel = 1e6; doc.value = insertPicture(doc.value, kind, r.data.reference, alt, fit);
          dirty = true; doc.dispatchEvent(new Event('input'));
          var p = 'src/' + r.data.reference.slice(6); delete picNodes[p]; bust[p] = Date.now();
          refreshPics(doc.value);
          $('#ap-file').value = '';
          setStatus(msg, kind === 'about' ? 'Headshot replaced. Press Save to publish it.' : 'Picture added below. Press Save to publish it.', 'ok');
          msg.scrollIntoView({ block: 'nearest' });
        });
      }

      /* Shows every picture the file mentions (the ../../assets/... paths), read from the site's own folders. */
      var picNodes = {}, picTimer = 0, bust = {};
      function refreshPics(text) {
        var box = $('#pics'); if (!box) return;
        if (current.kind !== 'about') { renderMedia(text); return; }
        var found = [], re = /\.\.\/\.\.\/assets\/[A-Za-z0-9._\/-]+\.(?:jpe?g|png|webp)/gi, m;
        while ((m = re.exec(text))) { var p = 'src/' + m[0].slice(6); if (found.indexOf(p) < 0) found.push(p); }
        // pictures written as just a file name live in this kind of page's own folder
        var bare = /^\s*(?:-\s+)?src:\s*"?([A-Za-z0-9][A-Za-z0-9._-]*\.(?:jpe?g|png|webp))"?\s*(?:#.*)?$/gim;
        while ((m = bare.exec(text))) { var bp = 'src/assets/' + (current.kind === 'timeline' ? 'timeline' : 'work') + '/' + m[1]; if (found.indexOf(bp) < 0) found.push(bp); }
        var vids = videosIn(text);
        box.innerHTML = '';
        if (!found.length && !vids.length) { box.innerHTML = '<p class="hint" style="grid-column:1/-1">No pictures in this file yet. Upload one and it is added for you.</p>'; return; }
        found.forEach(function (p) {
          if (!picNodes[p]) {
            var fig = document.createElement('figure'); fig.className = 'pic';
            var btn = document.createElement('button'); btn.type = 'button'; btn.className = 'picbtn'; btn.setAttribute('aria-label', 'View ' + p.split('/').pop() + ' larger');
            var img = document.createElement('img'); img.alt = 'Preview of ' + p.split('/').pop(); img.loading = 'lazy';
            var cap = document.createElement('figcaption'); cap.textContent = p.replace(/^src\/assets\//, '');
            img.addEventListener('error', function () { fig.classList.add('missing'); fig.innerHTML = 'Not uploaded yet'; var c = document.createElement('figcaption'); c.textContent = cap.textContent; fig.appendChild(c); if (fig._x) fig.appendChild(fig._x); });
            img.src = '/api/edit/image?path=' + encodeURIComponent(p) + (bust[p] ? '&v=' + bust[p] : '');
            btn.appendChild(img); fig.appendChild(btn); fig.appendChild(cap);
            if (current.kind !== 'about') {
              var x = document.createElement('button'); x.type = 'button'; x.className = 'picx'; x.textContent = '×'; x.setAttribute('aria-label', 'Remove ' + p.split('/').pop() + ' from this section');
              x.addEventListener('click', function () { dropPicture(p); });
              fig.appendChild(x); fig._x = x;
            }
            picNodes[p] = fig;
          }
          box.appendChild(picNodes[p]);
        });
        vids.forEach(function (v) {
          var id = youtubeId(v.url), fig = document.createElement('figure'); fig.className = 'pic';
          var img = document.createElement('img'); img.alt = 'Thumbnail of the video ' + v.title; img.loading = 'lazy';
          if (id) img.src = 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg';
          var cap = document.createElement('figcaption'); cap.textContent = 'Video: ' + (v.title || v.url);
          var a = document.createElement('a'); a.href = v.url; a.target = '_blank'; a.rel = 'noopener'; a.className = 'vidlink'; a.setAttribute('aria-label', 'Open the video ' + v.title + ' on YouTube'); a.appendChild(img);
          var x = document.createElement('button'); x.type = 'button'; x.className = 'picx'; x.textContent = '×'; x.setAttribute('aria-label', 'Remove the video ' + v.title + ' from this section');
          x.addEventListener('click', function () { dropVideo(v.url); });
          fig.appendChild(a); fig.appendChild(cap); fig.appendChild(x); box.appendChild(fig);
        });
      }

      function openFile(path) {
        main.innerHTML = '<h2>Loading…</h2>';
        api('/api/edit/file?path=' + encodeURIComponent(path)).then(function (r) {
          if (r.status === 401) { location.reload(); return; }
          if (!r.ok) { main.textContent = r.data.error || 'Could not open that file.'; return; }
          current = { path: path, kind: r.data.kind, sha: r.data.sha };
          dirty = false; renderSide();
          renderDoc(r.data.text);
          var d = readDraft();
          if (d && d.path === path && d.sha === r.data.sha && d.text !== r.data.text) {
            $('#doc').value = d.text; dirty = true; if ($('#prev')) { refreshPics(d.text); $('#prev').innerHTML = md(bodyOf(d.text)); }
            setStatus($('#msg'), 'Your unsaved changes were restored. Press Save to publish them.', 'ok');
          } else if (d && d.path === path) clearDraft();
          main.focus();
        });
      }

      function renderDoc(text) {
        var isMd = current.kind !== 'site';
        var title = current.kind === 'site' ? files.site.label : current.kind === 'about' ? files.about.label : ((/^title:\s*"?(.*?)"?\s*$/m.exec(text) || [])[1] || current.path);
        main.innerHTML =
          '<div class="bar"><div><h2 id="fname"></h2><div class="path"></div></div><button class="btn" id="save" type="button">Save</button></div>' +
          '<p id="msg" class="status" role="status" aria-live="polite"></p>' +
          '<details class="help"><summary>Example text template</summary><p>Compare your file with this example, or copy it to start from. Lines starting with <code>#</code> are notes to you.</p><pre class="tpl" id="tpl" tabindex="0"></pre><button class="btn ghost small" id="copytpl" type="button">Copy the template</button></details>' +
          '<div class="field"><label for="doc">' + (isMd ? 'The page file' : 'The settings file') + '</label><textarea id="doc" rows="30" spellcheck="false"></textarea></div>' +
          (isMd ? '<details class="prevwrap" open><summary>Preview of the text</summary><div class="preview" id="prev"></div></details>' +
            '<details class="prevwrap" open><summary>' + (current.kind === 'about' ? 'Pictures in this file' : 'Pictures &amp; videos (drag to reorder)') + '</summary>' + '<div class="pics" id="pics"></div><p id="pic-msg" class="status" role="status" aria-live="polite"></p>' + addPicBox() + addVideoBox() + '</details>' : '');
        $('#tpl').textContent = TEMPLATES[current.kind] || '';
        $('#copytpl').addEventListener('click', function () { navigator.clipboard && navigator.clipboard.writeText(TEMPLATES[current.kind] || ''); $('#copytpl').textContent = 'Copied'; });
        $('#fname').textContent = title;
        $('.path', main).textContent = current.path;
        var doc = $('#doc'); doc.value = text;
        picNodes = {};
        if (isMd) { $('#prev').innerHTML = md(bodyOf(text)); refreshPics(text); }
        doc.addEventListener('input', function () {
          dirty = true; keepDraft(doc.value);
          if (isMd) { $('#prev').innerHTML = md(bodyOf(doc.value)); clearTimeout(picTimer); picTimer = setTimeout(function () { refreshPics(doc.value); }, 350); }
        });
        $('#save').addEventListener('click', saveDoc);
        if (isMd) wireAddPic();
      }

      function saveDoc() {
        var msg = $('#msg'), btn = $('#save');
        btn.disabled = true; setStatus(msg, 'Saving…');
        api('/api/edit/file', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ path: current.path, text: $('#doc').value, sha: current.sha }) })
          .then(function (r) {
            btn.disabled = false;
            if (r.status === 401) { location.reload(); return; }
            if (r.ok) { current.sha = r.data.sha; dirty = false; clearDraft(); setStatus(msg, mode === 'GitHub' ? 'Saved. The live site updates in about a minute.' : 'Saved to the local files.', 'ok'); }
            else setStatus(msg, r.data.error || 'Could not save.', 'error', r.data.problems);
          });
      }

      /* ---------- New files ---------- */
      function slug(s) { return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60); }
      function newFile(kind) {
        var title = prompt(kind === 'work' ? 'Name of the new case study:' : 'Title of the new journey step:');
        if (!title || !slug(title)) return;
        var list = files[kind], n = list.length + 1;
        var name = ('0' + n).slice(-2) + '-' + slug(title);
        var path = 'src/content/' + kind + '/' + name + '.md';
        var t = title.replace(/"/g, "'");
        var text = kind === 'work'
          ? '---\ntitle: "' + t + '"\noutcome: "One line that sums up the project."\nrole: "Your role"\norg: "Organization"\ndates: "2024"\ntools: []\ntracks: [learning-design]\ndraft: true\n---\n\n### Context\n\nWrite the description here.\n'
          : '---\nlabel: "Tag"\nperiod: "2024 – Present"\ntitle: "' + t + '"\nskills: ["Skill one", "Skill two"]\n---\n\nWrite a few sentences about this stretch of your career.\n';
        api('/api/edit/file', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ path: path, text: text }) }).then(function (r) {
          if (r.ok) { loadList().then(function () { openFile(path); }); }
          else alert((r.data.error || 'Could not create it.') + ((r.data.problems || []).length ? '\n- ' + r.data.problems.join('\n- ') : ''));
        });
      }

      /* ---------- Uploads ---------- */
      function openResume() {
        current = { path: 'uploads:resume' }; dirty = false; renderSide();
        var resumes = files.resumes.map(function (r) { return '<option value="' + esc(r.id) + '">' + esc(r.title) + '</option>'; }).join('');
        main.innerHTML = '<h2>Replace a resume</h2>' +
          '<p class="hint">Choose which resume to replace, then pick the new PDF. The file name stays the same, so the card on the site just updates. PDFs can be up to 4 MB.</p>' +
          '<form id="up" novalidate><input type="hidden" id="u-target" value="resume" />' +
          '<div class="field"><label for="u-resume">Which resume?</label><select id="u-resume">' + resumes + '</select></div>' +
          '<div class="field"><label for="u-file">Choose the PDF</label><input id="u-file" type="file" accept="application/pdf" /></div>' +
          '<button class="btn" type="submit">Upload</button><p id="u-msg" class="status" role="status" aria-live="polite" style="margin-top:12px"></p><div id="u-result"></div></form>';
        $('#up').addEventListener('submit', doUpload);
      }

      // Shrinks big photos in the browser so they upload quickly (and fixes sideways phone photos).
      function prepare(file, target) {
        var isImg = /^image\/(jpeg|png|webp)$/.test(file.type);
        if (!isImg || !/image|headshot/.test(target)) return Promise.resolve(file);
        return createImageBitmap(file, { imageOrientation: 'from-image' }).then(function (bmp) {
          var max = 2000, s = Math.min(1, max / Math.max(bmp.width, bmp.height));
          if (s === 1 && file.size < 1500000 && target !== 'headshot') return file;
          var c = document.createElement('canvas'); c.width = Math.round(bmp.width * s); c.height = Math.round(bmp.height * s);
          c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
          var type = target === 'headshot' || file.type === 'image/jpeg' ? 'image/jpeg' : file.type;
          return new Promise(function (res) {
            c.toBlob(function (b) {
              var ext = type === 'image/jpeg' ? 'jpg' : type === 'image/png' ? 'png' : 'webp';
              res(new File([b], file.name.replace(/\.[^.]+$/, '') + '.' + ext, { type: type }));
            }, type, 0.86);
          });
        }).catch(function () { return file; });
      }

      function doUpload(e) {
        e.preventDefault();
        var msg = $('#u-msg'), out = $('#u-result'), f = $('#u-file').files[0], target = $('#u-target').value;
        out.innerHTML = '';
        if (!f) { setStatus(msg, 'Choose a file first.', 'error'); return; }
        setStatus(msg, 'Uploading…');
        var sent = null;
        prepare(f, target).then(function (file) {
          sent = file;
          var fd = new FormData(); fd.append('file', file); fd.append('target', target); fd.append('resumeId', $('#u-resume').value);
          return api('/api/edit/upload', { method: 'POST', body: fd });
        }).then(function (r) {
          if (r.status === 401) { location.reload(); return; }
          if (!r.ok) { setStatus(msg, r.data.error || 'Upload failed.', 'error'); return; }
          setStatus(msg, (r.data.replaced ? 'Replaced. ' : 'Uploaded. ') + (mode === 'GitHub' ? 'It appears on the live site in about a minute.' : ''), 'ok');
          var ref = r.data.reference;
          var use = target === 'work-image' || target === 'timeline-image' ? 'Paste this as the <code>src:</code> of a picture in the file you are editing (at the top, between the <code>---</code> lines).'
            : target === 'artifact' ? 'Paste this as the <code>url:</code> of an artifact in the case study file.'
            : target === 'headshot' ? 'Your headshot is replaced. Nothing else to do.' : 'That resume is replaced. Nothing else to do.';
          if (target === 'resume') { out.innerHTML = '<div class="result"><p>' + use + '</p></div>'; return; }  // nothing to copy for a resume
          out.innerHTML = '<div class="result"><p>' + use + '</p><p><code id="ref">' + esc(ref) + '</code> <button class="btn ghost small" id="copy" type="button">Copy</button></p>' + (sent && /^image\//.test(sent.type) ? '<img class="uppic" alt="Preview of the uploaded picture" src="' + URL.createObjectURL(sent) + '" />' : '') + '</div>';
          $('#copy').addEventListener('click', function () { navigator.clipboard && navigator.clipboard.writeText(ref); $('#copy').textContent = 'Copied'; });
        });
      }

      /* ---------- Reordering: drag a handle (mouse or touch), or focus it and use the up/down arrow keys ---------- */
      var sideMsg = null, drag = null, kbPrev = null, orderTimer = 0;
      function showSideMsg(text, kind) {
        sideMsg = text ? { text: text, kind: kind || '' } : null;
        var el = $('#side-msg'); if (el) { el.className = 'status' + (kind ? ' ' + kind : ''); el.textContent = text || ''; }
      }
      function idsOf(ul) { return Array.prototype.map.call(ul.children, function (li) { return li.dataset.id; }); }
      function applyOrder(kind, ids) {
        var id = function (f) { return f.name.replace(/\.md$/, ''); };
        files[kind].sort(function (a, b) { return ids.indexOf(id(a)) - ids.indexOf(id(b)); });
      }
      function saveOrder(kind, ids, previous) {
        applyOrder(kind, ids); showSideMsg('Saving the new order…');
        api('/api/edit/order', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ kind: kind, ids: ids }) }).then(function (r) {
          if (r.status === 401) { location.reload(); return; }
          if (r.ok) showSideMsg(mode === 'GitHub' ? 'Order saved. The live site updates in about a minute.' : 'Order saved to the local files.', 'ok');
          else { applyOrder(kind, previous); renderSide(); showSideMsg(r.data.error || 'Could not save the order.', 'error'); }
        });
      }
      side.addEventListener('pointerdown', function (e) {
        var grip = e.target.closest('.grip'); if (!grip || (e.pointerType === 'mouse' && e.button !== 0)) return;
        var li = grip.closest('li'), ul = li.parentNode;
        e.preventDefault(); grip.setPointerCapture(e.pointerId);
        drag = { li: li, ul: ul, kind: ul.dataset.kind, before: idsOf(ul) };
        li.classList.add('dragging'); document.body.style.cursor = 'grabbing';
      });
      side.addEventListener('pointermove', function (e) {
        if (!drag) return;
        var others = Array.prototype.filter.call(drag.ul.children, function (x) { return x !== drag.li; }), next = null;
        for (var k = 0; k < others.length; k++) { var r = others[k].getBoundingClientRect(); if (e.clientY < r.top + r.height / 2) { next = others[k]; break; } }
        if (next !== drag.li.nextElementSibling) drag.ul.insertBefore(drag.li, next);
        var sr = side.getBoundingClientRect();   // scroll the list when dragging near its top or bottom edge
        if (e.clientY < sr.top + 36) side.scrollTop -= 8; else if (e.clientY > sr.bottom - 36) side.scrollTop += 8;
      });
      function endDrag() {
        if (!drag) return;
        var d = drag; drag = null; d.li.classList.remove('dragging'); document.body.style.cursor = '';
        var now = idsOf(d.ul); if (now.join() !== d.before.join()) saveOrder(d.kind, now, d.before);
      }
      side.addEventListener('pointerup', endDrag);
      side.addEventListener('pointercancel', endDrag);
      side.addEventListener('keydown', function (e) {
        var grip = e.target.closest && e.target.closest('.grip');
        if (!grip || (e.key !== 'ArrowUp' && e.key !== 'ArrowDown')) return;
        e.preventDefault();
        var li = grip.closest('li'), ul = li.parentNode, before = idsOf(ul);
        if (e.key === 'ArrowUp' && li.previousElementSibling) ul.insertBefore(li, li.previousElementSibling);
        else if (e.key === 'ArrowDown' && li.nextElementSibling) ul.insertBefore(li.nextElementSibling, li);
        else return;
        grip.focus();
        showSideMsg('Moved "' + li.querySelector('.itembtn').textContent + '" to position ' + (idsOf(ul).indexOf(li.dataset.id) + 1) + ' of ' + ul.children.length + '.');
        if (!kbPrev) kbPrev = before;
        var kind = ul.dataset.kind; clearTimeout(orderTimer);
        orderTimer = setTimeout(function () { var now = idsOf(ul), prev = kbPrev; kbPrev = null; if (now.join() !== prev.join()) saveOrder(kind, now, prev); }, 700);
      });

      /* Click a picture to see it as large as the window allows, never bigger than the screen. */
      var lb = $('#lightbox');
      function fitViewer() {
        var img = $('#lb-img'); if (!img.naturalWidth) return;
        var bar = $('.lb-bar', lb).offsetHeight || 46;
        var maxW = window.innerWidth * 0.96 - 2, maxH = window.innerHeight * 0.96 - bar - 2;
        var s = Math.min(maxW / img.naturalWidth, maxH / img.naturalHeight); // as big as the window allows
        img.style.width = Math.floor(img.naturalWidth * s) + 'px';
        img.style.height = Math.floor(img.naturalHeight * s) + 'px';
      }
      $('#lb-img').addEventListener('load', fitViewer);
      window.addEventListener('resize', function () { if (lb.open) fitViewer(); });
      function zoom(src, name) {
        var img = $('#lb-img'); img.style.width = ''; img.style.height = '';
        img.src = src; $('#lb-name').textContent = name; lb.showModal(); fitViewer();
      }
      $('#lb-close').addEventListener('click', function () { lb.close(); });
      lb.addEventListener('click', function (e) { if (e.target === lb) lb.close(); });
      main.addEventListener('click', function (e) {
        var img = e.target.closest('.picbtn img, .uppic'); if (!img) return;
        zoom(img.src, img.alt.replace(/^Preview of /, ''));
      });

      loadList();
    })();
  </script>
</body>
</html>
