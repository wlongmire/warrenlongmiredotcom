---
// The /edit page: a password-protected place to change the site's CONTENT (text, pictures, files).
// It cannot change layouts or code. Saves become commits on GitHub, which redeploy the site.
import { isAuthed, passwordConfigured } from '../../lib/editor/auth';
import { storageMode } from '../../lib/editor/storage';

export const prerender = false;

const authed = isAuthed(Astro.request);
const setupNeeded = !passwordConfigured();
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Edit the site</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    /* Same night-studio palette as the public site. */
    :root { color-scheme: dark; --bg: #0b1426; --card: #12203a; --raised: #1a2d50; --ink: #f4ecd8; --muted: #b9b3a3; --line: #24365a; --accent: #f0b34a; --accent-ink: #0b1426; --bad: #ff9a9f; --ok: #8fd9a3; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.55 'Inter', system-ui, sans-serif; }
    h1, h2, h3 { font-family: 'Fraunces', Georgia, serif; line-height: 1.2; margin: 0 0 .5em; }
    code { background: var(--bg); border: 1px solid var(--line); padding: 0 5px; border-radius: 4px; font-size: .92em; }
    a { color: inherit; }
    button, input, select, textarea { font: inherit; color: inherit; }
    button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
    .btn { background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 6px; padding: 9px 18px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn:hover:not(:disabled) { filter: brightness(1.08); }
    .btn:disabled { opacity: .55; cursor: default; }
    .btn.ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--line); }
    .btn.ghost:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); filter: none; }
    .btn.small { padding: 5px 12px; font-size: 14px; }
    input[type='text'], input[type='email'], input[type='password'], input[type='url'], select, textarea { width: 100%; border: 1.5px solid var(--line); border-radius: 6px; padding: 9px 11px; background: var(--bg); color: var(--ink); }
    select option { background: var(--bg); }
    textarea { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 14.5px; line-height: 1.65; resize: vertical; tab-size: 2; }
    label { display: block; font-weight: 600; margin: 0 0 6px; }
    .hint { color: var(--muted); font-size: 14px; margin: 6px 0 0; }
    .status { min-height: 1.5em; font-weight: 600; margin: 0; }
    .status.error { color: var(--bad); }
    .status.ok { color: var(--ok); }
    .problems { margin: 6px 0 0; padding-left: 20px; font-weight: 400; }

    .login { max-width: 400px; margin: 12vh auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 30px; }
    .login .field { margin: 18px 0; }

    .top { display: flex; align-items: center; gap: 12px; padding: 14px 24px; background: color-mix(in srgb, var(--bg) 90%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
    .top h1 { font-size: 20px; margin: 0 auto 0 0; }
    .mode { font-size: 13px; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 2px 12px; }
    .layout { display: grid; grid-template-columns: 290px minmax(0, 1fr); gap: 22px; padding: 24px; max-width: 1320px; margin: 0 auto; }
    @media (max-width: 880px) { .layout { grid-template-columns: 1fr; } }

    .side { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 14px 12px; align-self: start; position: sticky; top: 78px; max-height: calc(100vh - 100px); overflow: auto; }
    @media (max-width: 880px) { .side { position: static; max-height: none; } }
    /* Section titles are the big headings; the items under each one are smaller and indented. */
    .side h2 { font: 600 19px/1.25 'Fraunces', Georgia, serif; color: var(--accent); margin: 24px 0 6px 4px; padding-bottom: 7px; border-bottom: 1px solid var(--line); }
    .side h2:first-child { margin-top: 2px; }
    .side ul { list-style: none; margin: 0 0 0 12px; padding: 0 0 0 10px; border-left: 1px solid var(--line); }
    .side li button { width: 100%; text-align: left; background: transparent; border: 0; border-radius: 6px; padding: 6px 10px; font-size: 14px; line-height: 1.35; cursor: pointer; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .side li button:hover { background: var(--raised); color: var(--ink); }
    .side li button[aria-current='true'] { background: var(--raised); box-shadow: inset 3px 0 0 var(--accent); font-weight: 600; color: var(--ink); }
    .newbtn { margin: 8px 0 0 22px; font-size: 13px; }
    /* Drag and drop: the handle on the left of each item moves it. */
    .side ul.sortable li { display: flex; align-items: center; gap: 2px; border-radius: 6px; }
    .side ul.sortable li button.grip { flex: none; width: 22px; padding: 6px 0; text-align: center; cursor: grab; touch-action: none; color: var(--muted); font-size: 15px; letter-spacing: -2px; }
    .side ul.sortable li button.grip:hover { color: var(--accent); background: transparent; }
    .side ul.sortable li button.itembtn { flex: 1; width: auto; min-width: 0; }
    .side ul.sortable li.dragging { position: relative; z-index: 3; background: var(--raised); box-shadow: 0 8px 22px rgba(0,0,0,.5); }
    .side ul.sortable li.dragging button.grip { cursor: grabbing; color: var(--accent); }
    #side-msg { min-height: 0; margin: 0 0 4px 4px; font-size: 14px; }
    #side-msg:not(:empty) { margin-bottom: 12px; }

    .main { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 0 22px 22px; min-height: 380px; }
    .bar { position: sticky; top: 56px; z-index: 5; background: var(--card); padding: 18px 0 10px; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line); margin-bottom: 14px; }
    .bar h2 { font-size: 24px; margin: 0; }
    .path { font: 13px ui-monospace, Menlo, Consolas, monospace; color: var(--muted); margin-top: 2px; }
    .help { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px; margin: 0 0 14px; font-size: 14.5px; }
    .help summary { cursor: pointer; font-weight: 600; color: var(--accent); }
    .help p { margin: 8px 0 0; }
    .tpl { margin: 10px 0 12px; padding: 12px 14px; background: var(--card); border: 1px solid var(--line); border-radius: 6px; font: 13px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--muted); white-space: pre-wrap; overflow: auto; max-height: 340px; }
    .field { margin: 0 0 16px; }
    .prevwrap { margin-top: 16px; border: 1px solid var(--line); border-radius: 8px; padding: 10px 16px; }
    .prevwrap summary { cursor: pointer; font-weight: 600; color: var(--accent); }
    .preview { padding-top: 8px; }
    .preview h3 { font-size: 18px; color: var(--accent); margin: 16px 0 6px; }
    .preview p, .preview ul { margin: 0 0 10px; }
    .preview a { color: var(--accent); }
    .main:focus { outline: none; }
    .addpic { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; margin: 16px 0 4px; }
    .addpic label { margin-top: 10px; }
    .addpic label:first-child { margin-top: 0; }
    .addpic input[type='file'] { padding: 7px; }
    .addpic #ap-details label:first-child { margin-top: 10px; }
    .addpic .row { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 12px; }
    .pics { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 12px; padding-top: 10px; }
    .pic { position: relative; margin: 0; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
    .pic .picx { position: absolute; top: 6px; right: 6px; z-index: 2; width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(255,255,255,.35); background: rgba(8, 14, 28, .78); color: #fff; font-size: 18px; line-height: 1; cursor: pointer; padding: 0; }
    .pic .picx:hover { background: var(--bad); border-color: var(--bad); color: #0b1426; }
    #pic-msg { margin-top: 12px; }
    #pic-msg .btn { margin-left: 8px; }
    .pics.mediabox { display: block; }
    .mprev { background: #000; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
    .mprev .picbtn { display: block; width: 100%; padding: 0; border: 0; background: #000; cursor: zoom-in; }
    #mtop { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 4px 16px; align-items: start; }
    @media (max-width: 640px) { #mtop { grid-template-columns: 1fr; } }
    .mprev img { display: block; width: 100%; height: 150px; object-fit: contain; background: #000; }
    .mvideo { position: relative; aspect-ratio: 16 / 9; width: 100%; background: #000; }
    .mvideo iframe, .mvideo .mplay { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .mvideo .mplay { padding: 0; background: #000; cursor: pointer; }
    .mvideo .mplay img { height: 100%; opacity: .85; object-fit: cover; }
    .mvideo .mplay span { position: absolute; left: 50%; top: 50%; width: 40px; height: 40px; margin: -20px 0 0 -20px; display: grid; place-items: center; padding-left: 5px; box-sizing: border-box; border-radius: 50%; background: var(--accent); color: #0b1426; font-size: 16px; }
    .mfields { margin: 0 0 4px; }
    .mfields label:first-child { margin-top: 0; }
    .mhint { margin: 10px 0 6px; color: var(--muted); font-size: 14px; }
    .mlist { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 6px; }
    .mitem { display: grid; grid-template-columns: 30px 1fr 30px; align-items: stretch; font-size: 14px; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
    .mitem.sel { border-color: var(--accent); }
    .mitem.dragging { position: relative; z-index: 3; background: var(--raised); box-shadow: 0 8px 22px rgba(0,0,0,.5); }
    .mitem button { border: 0; background: transparent; color: var(--muted); cursor: pointer; font: inherit; }
    .mitem .mgrip { cursor: grab; touch-action: none; font-size: 18px; }
    .mitem.dragging .mgrip { cursor: grabbing; color: var(--accent); }
    .mitem .mpick { display: flex; align-items: center; gap: 10px; text-align: left; padding: 4px 8px 4px 0; color: var(--text); min-width: 0; }
    .mitem .mpick img { width: 48px; height: 30px; object-fit: cover; background: #000; border-radius: 4px; flex: none; }
    .mitem .mname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mitem .mname b { color: var(--accent); font-weight: 600; margin-right: 6px; }
    .mitem .mx { font-size: 20px; }
    .mitem .mx:hover { background: var(--bad); color: #0b1426; }
    .pic .vidlink { display: block; width: 100%; background: #000; }
    .pic .picbtn { display: block; width: 100%; padding: 0; border: 0; background: #000; cursor: zoom-in; }
    .pic img { display: block; width: 100%; height: 190px; object-fit: contain; background: #000; }
    .pic figcaption { padding: 6px 8px; font: 12px ui-monospace, Menlo, Consolas, monospace; color: var(--muted); word-break: break-all; }
    .pic.missing { padding: 14px 10px; color: var(--bad); font-size: 14px; }
    .pic.missing figcaption { padding: 6px 0 0; }
    .uppic { display: block; max-width: min(100%, 320px); max-height: 240px; margin-top: 10px; border-radius: 6px; background: #000; border: 1px solid var(--line); cursor: zoom-in; }
    .lightbox { padding: 0; border: 1px solid var(--line); border-radius: 12px; background: #000; color: var(--ink); max-width: 96vw; max-height: 96vh; min-width: min(280px, 96vw); overflow: hidden; }
    .lightbox::backdrop { background: rgba(5, 10, 20, .82); }
    /* The script sizes the picture to the largest size that still fits the window (it can also enlarge small ones). */
    .lightbox img { display: block; max-width: 96vw; max-height: calc(96vh - 46px); object-fit: contain; margin: 0 auto; }
    .lightbox .lb-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 12px; background: var(--card); font: 13px ui-monospace, Menlo, Consolas, monospace; color: var(--muted); }
    .result { background: var(--bg); border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 8px; padding: 10px 14px; margin-top: 14px; }
    .result code { word-break: break-all; }
    .main > h2 { margin-top: 22px; }
  </style>
</head>
<body>
  {setupNeeded ? (
    <main class="login">
      <h1>Editing isn't set up yet</h1>
      <p>Add a password in the site's settings so this page can be protected: a variable named <code>EDIT_PASSWORD</code>. Then reload this page.</p>
    </main>
  ) : !authed ? (
    <main class="login">
      <h1>Edit the site</h1>
      <p class="hint">Enter the editing password to continue.</p>
      <form id="login-form" novalidate>
        <div class="field">
          <label for="pw">Password</label>
          <input id="pw" type="password" autocomplete="current-password" required />
        </div>
        <button class="btn" type="submit">Sign in</button>
        <p id="login-status" class="status error" role="alert" style="margin-top:12px"></p>
      </form>
    </main>
  ) : (
    <div id="app" data-mode={storageMode()}>
      <header class="top">
        <h1>Edit the site</h1>
        <span class="mode" id="mode"></span>
        <a class="btn ghost small" href="/" target="_blank" rel="noopener">View site</a>
        <button class="btn ghost small" id="logout" type="button">Sign out</button>
      </header>
      <div class="layout">
        <nav class="side" aria-label="Things you can edit, in the order they appear on the site" id="side">Loading…</nav>
        <dialog class="lightbox" id="lightbox" aria-label="Picture viewer"><div class="lb-bar"><span id="lb-name"></span><button class="btn ghost small" id="lb-close" type="button">Close</button></div><img id="lb-img" alt="" /></dialog>
        <main class="main" id="main" tabindex="-1">
          <h2>Choose something to edit</h2>
          <p>The list on the left follows the page from top to bottom, the same order visitors see it.</p>
          <p class="hint">Your changes go live on the site about a minute after you press Save.</p>
        </main>
      </div>
    </div>
  )}

  <script is:inline>
    (function () {
      var $ = function (s, r) { return (r || document).querySelector(s); };
      var HEAD = { 'x-edit': '1' };
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };

      function api(url, opts) {
        opts = opts || {};
        opts.headers = Object.assign({}, HEAD, opts.headers || {});
        return fetch(url, opts).then(function (r) {
          return r.json().catch(function () { return {}; }).then(function (data) { return { ok: r.ok, status: r.status, data: data }; });
        });
      }

      /* ---------- Login ---------- */
      var lf = $('#login-form');
      if (lf) {
        lf.addEventListener('submit', function (e) {
          e.preventDefault();
          var st = $('#login-status'); st.className = 'status'; st.textContent = 'Checking…';
          api('/api/edit/login', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ password: $('#pw').value }) })
            .then(function (r) {
              if (r.ok) location.reload();
              else { st.className = 'status error'; st.textContent = r.data.error || 'Could not sign in.'; }
            });
        });
        return;
      }
      var app = $('#app');
      if (!app) return;

      /* ---------- Editor ---------- */
      var side = $('#side'), main = $('#main');
      var files = null, current = null, dirty = false, mode = app.dataset.mode;
      $('#mode').textContent = mode === 'GitHub' ? 'Saving to the live site' : 'Test mode: saving to local files';

      $('#logout').addEventListener('click', function () {
        api('/api/edit/logout', { method: 'POST' }).then(function () { location.reload(); });
      });
      /* Unsaved edits are kept in this browser tab, so a page reload (the local dev server reloads the page when a new
         picture file appears) does not lose them. */
      function readDraft() { try { return JSON.parse(sessionStorage.getItem('edit-draft') || 'null'); } catch (e) { return null; } }
      function keepDraft(text) { try { sessionStorage.setItem('edit-draft', JSON.stringify({ path: current.path, sha: current.sha, text: text })); } catch (e) {} }
      function clearDraft() { try { sessionStorage.removeItem('edit-draft'); } catch (e) {} }
      var localHost = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
      window.addEventListener('beforeunload', function (e) { if (dirty && !localHost) { e.preventDefault(); e.returnValue = ''; } });

      function setStatus(el, msg, kind, problems) {
        el.className = 'status' + (kind ? ' ' + kind : '');
        el.textContent = msg;
        if (problems && problems.length) {
          var ul = document.createElement('ul'); ul.className = 'problems';
          problems.forEach(function (p) { var li = document.createElement('li'); li.textContent = p; ul.appendChild(li); });
          el.appendChild(ul);
        }
      }
      function confirmLeave() { return !dirty || confirm('You have changes that are not saved. Leave without saving?'); }

      function loadList() {
        return api('/api/edit/files').then(function (r) {
          if (r.status === 401) { location.reload(); return; }
          if (!r.ok) { side.textContent = r.data.error || 'Could not load the list.'; return; }
          files = r.data; renderSide();
          if (!current) openFile((readDraft() || {}).path || files.about.path); // start on the home page intro (or where an unsaved edit was)
        });
      }

      /* The list follows the page from top to bottom, the same order visitors see it. */
      function item(label, attrs, path) {
        var on = current && current.path === path ? ' aria-current="true"' : '';
        return '<li><button type="button" ' + attrs + on + '>' + esc(label) + '</button></li>';
      }
      function head(title) { return '<h2>' + esc(title) + '</h2>'; }
      /* My Journey and Work History: each item has a handle to drag (or use the up/down arrow keys on it). */
      function sortableList(kind, arr) {
        return '<ul class="sortable" data-kind="' + kind + '">' + arr.map(function (f) {
          var on = current && current.path === f.path ? ' aria-current="true"' : '';
          return '<li data-id="' + esc(f.name.replace(/\.md$/, '')) + '"><button type="button" class="grip" title="Drag to reorder" aria-label="Move ' + esc(f.label) + '. Drag it, or use the up and down arrow keys.">⠿</button>' +
            '<button type="button" class="itembtn" title="' + esc(f.title || f.label) + '" data-open="' + esc(f.path) + '"' + on + '>' + esc(f.label) + '</button></li>';
        }).join('') + '</ul>';
      }
      function renderSide() {
        var h = '<p id="side-msg" class="status' + (sideMsg && sideMsg.kind ? ' ' + sideMsg.kind : '') + '" role="status" aria-live="polite">' + (sideMsg ? esc(sideMsg.text) : '') + '</p>';
        h += head('Top of the page');
        h += '<ul>' + item(files.about.label, 'data-open="' + esc(files.about.path) + '"', files.about.path) + '</ul>';
        h += head('My Journey');
        h += sortableList('timeline', files.timeline);
        h += '<button class="btn ghost small newbtn" type="button" data-new="timeline">+ New step</button>';
        h += head('Work History');
        h += sortableList('work', files.work);
        h += '<button class="btn ghost small newbtn" type="button" data-new="work">+ New case study</button>';
        h += head('Resumes');
        h += '<ul>' + item('Replace a resume PDF', 'data-resume="1"', 'uploads:resume') + '</ul>';
        h += head('Footer & contact form');
        h += '<ul>' + item(files.site.label, 'data-open="' + esc(files.site.path) + '"', files.site.path) + '</ul>';
        side.innerHTML = h;
      }
      side.addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b || b.classList.contains('grip')) return;
        if (!confirmLeave()) return;
        if (b.dataset.open) openFile(b.dataset.open);
        else if (b.dataset.resume) openResume();
        else if (b.dataset.new) newFile(b.dataset.new);
      });

      /* ---------- One continuous file ---------- */
      var TEMPLATES = {
        work: [
        '---',
        'title: "Name of the project"',
        'outcome: "One line that sums up the project (shown on the card)."',
        'role: "Your role"',
        'org: "Organization"',
        'dates: "2023–Present"',
        'tools: []',
        'tracks: [learning-design, teaching]   # learning-design, teaching, engineering, design-ux',
        'draft: false                          # true hides it from the site',
        '# Optional extras for the popup (delete what you do not need):',
        'media:                                         # pictures and videos, shown as a slideshow in this order',
        '  - type: image',
        '    src: "your-picture.jpg"                      # upload it first, then type its file name',
        '    alt: "Describe the picture in a short phrase"',
        '    fit: contain                                # or cover',
        '  - type: video',
        '    url: "https://youtu.be/XXXXXXXXXXX"',
        '    title: "The title of the video"',
        'artifacts:',
        '  - label: "Name of a file"',
        '    url: "/artifacts/your-file.pdf"',
        'links:',
        '  - label: "Name of a link"',
        '    url: "https://example.com"',
        '---',
        '',
        '### Context',
        '',
        'Why this project existed, in a few plain sentences.',
        '',
        '### Approach',
        '',
        'What you did and why.',
        '',
        '### What I built',
        '',
        '- First thing',
        '- Second thing',
        '',
        '### Outcome',
        '',
        'What changed as a result.'
      ].join('\n'),
        timeline: [
        '---',
        'label: "Design"                 # the short tag shown first',
        'period: "2004 – 2009"           # the dates',
        'title: "Name of this stretch of your career"',
        'skills: ["Skill one", "Skill two", "Skill three"]   # the small pills',
        '# Optional pictures and videos, shown as a slideshow in this order:',
        'media:',
        '  - type: image',
        '    src: "your-picture.jpg"                         # upload it first, then type its file name',
        '    alt: "Describe the picture in a short phrase"',
        '    fit: contain                                    # or cover',
        '  - type: video',
        '    url: "https://youtu.be/XXXXXXXXXXX"',
        '    title: "The title of the video"',
        '---',
        '',
        'A few plain sentences about this stretch of your career: what you did and what changed.'
      ].join('\n'),
