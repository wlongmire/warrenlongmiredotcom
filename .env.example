# Copy this file to .env for local testing (.env is never committed). On the live site, set the same
# names in Vercel: Project -> Settings -> Environment Variables.

# The one password that unlocks /edit. Use a long phrase.
EDIT_PASSWORD=

# A GitHub "fine-grained personal access token" limited to this one repository, with
# Repository permissions -> Contents: Read and write. Leave empty locally to edit the local files instead.
GITHUB_TOKEN=

# Optional. These are the defaults:
# GITHUB_REPO=wlongmire/warrenlongmiredotcom
# GITHUB_BRANCH=main
